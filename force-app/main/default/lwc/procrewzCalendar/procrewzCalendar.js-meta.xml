<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>ProCrewz Calendar</masterLabel>
    <description
  >A date picker calendar component powered by Vanilla Calendar Pro</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig
      targets="lightning__AppPage,lightning__RecordPage,lightning__HomePage"
    >
            <property
        name="locale"
        type="String"
        default="en"
        label="Locale"
        description="Language locale code (e.g., en, es, fr)"
      />
            <property
        name="selectionMode"
        type="String"
        default="single"
        label="Selection Mode"
        description="Date selection mode: single, multiple, or multiple-ranged"
      />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
